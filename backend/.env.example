# Copie para .env e preencha os valores reais. Nunca commitar o .env real.

NODE_ENV=development
PORT=3333

# Ao rodar via docker-compose, o host é o nome do serviço ("db"), não localhost.
DATABASE_URL="postgresql://eventos:eventos@localhost:5432/eventos_db?schema=public"

# Segredos de autenticação e assinatura do QR — gere valores aleatórios reais,
# nunca reutilize os de exemplo em produção.
JWT_SECRET="troque-por-um-segredo-aleatorio-forte"
QR_SIGNING_SECRET="troque-por-outro-segredo-aleatorio-forte"

# Preencha com uma das duas (ou ambas) — ver docs/MODELAGEM.md
TICKETMASTER_API_KEY=""
TMDB_API_KEY=""

LOG_LEVEL=info
